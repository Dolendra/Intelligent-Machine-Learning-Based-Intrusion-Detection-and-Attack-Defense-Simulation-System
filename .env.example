# Copy to .env and adjust as needed (optional — config.yaml is the main source)
IDS_DATA_DIR=MachineLearningCVE
IDS_PROCESSED_DIR=data/processed
IDS_MODEL_DIR=models/trained_models
IDS_DB_URL=sqlite:///./database/ids.db
# Leave unset to use config.yaml (currently 1.0 for full CICIDS2017)
# IDS_SAMPLE_FRAC=1.0
IDS_RANDOM_STATE=42
IDS_API_HOST=0.0.0.0

# Demonstration convenience only. API default is false when unset.
# docker-compose.yml sets DEMO_MODE=true for demos.
DEMO_MODE=false

# Optional: use calibrated binary wrapper if binary_calibrated.joblib exists
# IDS_USE_CALIBRATED_BINARY=true

# Optional API hardening / P4 auth
# AEGIS_AUTH_ENABLED=true
# AEGIS_API_KEY=
# AEGIS_AUTH_SECRET=
# AEGIS_TOKEN_TTL_SECONDS=28800
# DISABLE_API_AUTH=false
# AEGIS_ALLOW_ROLE_HEADER=false
# P5 application security
# AEGIS_RATE_LIMIT_ENABLED=true
# DISABLE_RATE_LIMIT=false
# AEGIS_REQUEST_LIMITS=true
# DISABLE_REQUEST_LIMITS=false
# AEGIS_CORS_STRICT=true
# AEGIS_EXPOSE_ERRORS=false
# Optional seed password overrides:
# AEGIS_SEED_PASSWORD_ADMIN=
# AEGIS_SEED_PASSWORD_RESPONDER=
# AEGIS_SEED_PASSWORD_ANALYST=
# AEGIS_SEED_PASSWORD_VIEWER=
